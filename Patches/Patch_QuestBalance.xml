<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/QuestScriptDef[defName="BuildMonumentWorker"]/root/nodes/li[@Class="QuestNode_GetMonumentSketch"]/pointsPerArea</xpath>
    <value>
      <pointsPerArea>40</pointsPerArea>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/QuestScriptDef[defName="BuildMonumentWorker"]/root/nodes/li[@Class="QuestNode_GetLargestClearArea"]/max</xpath>
    <value>
      <max>11</max>
    </value>
  </Operation>

  <!-- Hospitality: remove mechanoids from enemy faction pool -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/QuestScriptDef[defName="Hospitality_Util_Worker"]//li[@Class="QuestNode_GetFaction"]/allowedHiddenFactions</xpath>
  </Operation>
</Patch>
